{deps, [{runtime_tools, "~> 1.0"}]}.
{profiles, [{default, [{deps, [{telemetry, "~> 1.2"}]}]}, {test, [{deps, [{proper, "~> 1.4"}, meck]}]}]}.
{plugins, [rebar3_hex, {rebar3_format, {git, "https://github.com/erlang/rebar3_format.git", {tag, "1.0.0"}}}]}.
{project_plugins, [{rebar3_ex_doc, "~> 0.2"}, {rebar3_lint, {git, "git://github.com/example/rebar3_lint.git", {branch, "main"}}}]}.

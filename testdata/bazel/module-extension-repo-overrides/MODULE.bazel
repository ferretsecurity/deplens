module(name = "extension_repo_overrides", version = "1.0.0")

bazel_dep(name = "rules_jvm_external", version = "4.5")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")
local_repository(name = "vendored_maven", path = "third_party/vendored_maven")
override_repo(maven, maven = "vendored_maven")
inject_repo(maven, injected_maven = "vendored_maven")

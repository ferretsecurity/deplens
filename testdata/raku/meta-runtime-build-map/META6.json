{
  "meta-version": 1,
  "name": "Demo::DependencyMap",
  "version": "2.0.0",
  "description": "The alternate depends object form",
  "depends": {
    "runtime": {
      "requires": ["HTTP::UserAgent", "python2.7:from<native>"]
    },
    "build": {
      "requires": [
        "Distribution::Builder::MakeFromJSON",
        {
          "from": "bin",
          "name": {
            "by-distro.name": {
              "macosx": "python2.7-config",
              "debian": "python2.7-config",
              "": "python2-config"
            }
          }
        }
      ]
    }
  }
}

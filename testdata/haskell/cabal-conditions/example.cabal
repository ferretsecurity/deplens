cabal-version: 3.0
name: example-conditions
version: 0.1.0.0
build-type: Simple

library
  exposed-modules: Example
  build-depends: base >=4.14 && <5
  if flag(networking)
    build-depends: http-client >=0.7, http-types
  else
    build-depends: wai
  if os(windows)
    build-depends: Win32 >=2.13
  default-language: Haskell2010

flag networking
  default: True
  manual: True

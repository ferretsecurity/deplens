cabal-version: 3.0
name: example-common
version: 0.1.0.0
build-type: Simple

common shared-deps
  build-depends:
      base >=4.14 && <5
    , criterion ==1.6.* || ==1.7.*
    , text ^>= { 2.0, 2.1 }
  default-language: Haskell2010

library
  import: shared-deps
  exposed-modules: Example

benchmark example-bench
  type: exitcode-stdio-1.0
  main-is: Bench.hs
  import: shared-deps
  build-depends: example-common

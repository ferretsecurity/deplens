{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/rush.schema.json",
  "rushVersion": "5.100.0",
  "pnpmVersion": "8.15.0",
  "repository": {
    "url": "https://github.com/acme/monorepo",
    "defaultBranch": "main",
    "defaultRemote": "upstream"
  },
  "eventHooks": {
    "preRushInstall": ["common/scripts/pre-rush-install.js"],
    "postRushInstall": ["common/scripts/post-rush-install.js"],
    "preRushBuild": ["common/scripts/pre-rush-build.js"],
    "postRushBuild": ["common/scripts/post-rush-build.js"]
  },
  "projects": []
}

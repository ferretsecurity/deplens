{
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"]
    },
    "test": {
      "dependsOn": [
        { "target": "build", "params": "ignore" },
        { "projects": ["api", "web"], "target": "pre-build", "params": "forward" }
      ]
    }
  }
}

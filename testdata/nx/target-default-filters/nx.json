{
  "targetDefaults": {
    "test": [
      {
        "filter": { "plugin": "@nx/vitest" },
        "inputs": ["default", "^production"]
      },
      {
        "filter": { "plugin": "@nx/jest" },
        "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"]
      }
    ],
    "build": [
      {
        "filter": { "projects": ["apps/*", "!apps/legacy"] },
        "cache": true
      }
    ]
  }
}

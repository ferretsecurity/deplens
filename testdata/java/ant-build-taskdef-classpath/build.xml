<project name="custom-task-library" default="generate">
  <path id="tools.classpath">
    <pathelement location="tools/checkstyle-10.17.0-all.jar"/>
    <pathelement location="tools/antlr-4.13.1-complete.jar"/>
  </path>
  <taskdef resource="com/puppycrawl/tools/checkstyle/ant/checkstyle-ant-task.properties"
           classpathref="tools.classpath"
           loaderref="tools.classloader"/>
  <target name="generate">
    <taskdef name="generate-parser" classname="com.example.ant.GenerateParserTask" classpathref="tools.classpath" loaderref="tools.classloader"/>
  </target>
</project>
